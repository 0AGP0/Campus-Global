---
import "@fontsource-variable/dm-sans/wght.css";
import "../styles/global.css";
import { SiteHeader } from "@/components/layout/SiteHeader";
import { SiteFooter } from "@/components/layout/SiteFooter";
import { icefIas } from "@/data/home-ia";
import siteHead from "@/data/generated/site-head.json";
import { splitDeferredHeadHtml } from "@/lib/defer-head-third-party";

interface Props {
  title?: string;
  description?: string;
  /** Tam URL — kanonik ve og:url için */
  canonicalUrl?: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Tam URL veya sitedeki mutlak yol (/ görsel.png) */
  ogImage?: string;
  ogType?: "website" | "article";
  twitterCard?: "summary_large_image" | "summary";
  keywords?: string;
  robots?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  /** Sayfaya özel piksel. Site geneli kod ayrıca basılır. */
  headHtml?: string;
}

const {
  title = "Campus Global",
  description,
  canonicalUrl,
  ogTitle,
  ogDescription,
  ogImage,
  ogType = "website",
  twitterCard = "summary_large_image",
  keywords,
  robots = "index, follow",
  articlePublishedTime,
  articleModifiedTime,
  headHtml,
} = Astro.props as Props;

const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDesc = ogDescription ?? description ?? "";

const globalHead = splitDeferredHeadHtml(siteHead.globalHeadHtml ?? "");
const pageHead = splitDeferredHeadHtml(headHtml ?? "");
const metaPixelId = globalHead.metaPixelId || pageHead.metaPixelId;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/Campus%20Global%20Logo%20Tek.png" />
    <link rel="apple-touch-icon" href="/Campus%20Global%20Logo%20Tek.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description ? <meta name="description" content={description} /> : null}
    {keywords ? <meta name="keywords" content={keywords} /> : null}
    <meta name="robots" content={robots} />
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
    <meta property="og:title" content={resolvedOgTitle} />
    {resolvedOgDesc ? <meta property="og:description" content={resolvedOgDesc} /> : null}
    {canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content="Campus Global" />
    {ogImage ? <meta property="og:image" content={ogImage} /> : null}
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={resolvedOgTitle} />
    {resolvedOgDesc ? <meta name="twitter:description" content={resolvedOgDesc} /> : null}
    {ogImage ? <meta name="twitter:image" content={ogImage} /> : null}
    {articlePublishedTime ? <meta property="article:published_time" content={articlePublishedTime} /> : null}
    {articleModifiedTime ? <meta property="article:modified_time" content={articleModifiedTime} /> : null}
    {globalHead.immediateHtml ? <Fragment set:html={globalHead.immediateHtml} /> : null}
    {pageHead.immediateHtml ? <Fragment set:html={pageHead.immediateHtml} /> : null}
    <slot name="head-extra" />
    <!-- Influencer ref: defer — render'ı bloklamasın -->
    <script is:inline defer src="/cg-ref-persist.js"></script>
  </head>
  <body id="top" class="flex min-h-dvh flex-col font-sans text-zap-ink">
    <SiteHeader client:idle />
    <div class="flex min-h-0 flex-1 flex-col">
      <slot />
    </div>
    <SiteFooter />
    <!-- ICEF + Meta Pixel: ilk boyamadan sonra (TBT) -->
    <script is:inline define:vars={{ icefSrc: icefIas.badgeScriptSrc, metaPixelId }}>
      (() => {
        const afterIdle = (fn) => {
          if ("requestIdleCallback" in window) window.requestIdleCallback(fn, { timeout: 3500 });
          else window.addEventListener("load", () => setTimeout(fn, 2000), { once: true });
        };

        const loadIcef = () => {
          if (document.querySelector("script[data-icef-ias]")) return;
          const s = document.createElement("script");
          s.src = icefSrc;
          s.async = true;
          s.defer = true;
          s.crossOrigin = "anonymous";
          s.dataset.icefIas = "1";
          document.body.appendChild(s);
        };

        const loadMeta = () => {
          if (!metaPixelId || window.fbq) return;
          !(function (f, b, e, v, n, t, s) {
            if (f.fbq) return;
            n = f.fbq = function () {
              n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
            };
            if (!f._fbq) f._fbq = n;
            n.push = n;
            n.loaded = !0;
            n.version = "2.0";
            n.queue = [];
            t = b.createElement(e);
            t.async = !0;
            t.src = v;
            s = b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t, s);
          })(window, document, "script", "https://connect.facebook.net/en_US/fbevents.js");
          window.fbq("init", metaPixelId);
          window.fbq("track", "PageView");
        };

        const target = document.getElementById("iasBadge");
        if (target && "IntersectionObserver" in window) {
          const io = new IntersectionObserver(
            (entries) => {
              if (entries.some((e) => e.isIntersecting)) {
                io.disconnect();
                loadIcef();
              }
            },
            { rootMargin: "200px 0px" },
          );
          io.observe(target);
        } else {
          afterIdle(loadIcef);
        }

        afterIdle(loadMeta);
      })();
    </script>
  </body>
</html>
