---
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import { getCollection, render } from "astro:content";
import { resolveLeadFormPrefillFromPath } from "@/data/lead-form-data";
import { RESERVED_NON_ARTICLE_SLUGS } from "@/data/site-nav";
import { getSiteNavigation, collectSlugPathsFromNav } from "@/lib/cms/navigation";
import { getAllArticleSlugs, getCmsArticleBySlug } from "@/lib/cms/articles";

export async function getStaticPaths() {
  const nav = await getSiteNavigation();
  const paths = new Set(collectSlugPathsFromNav(nav));

  for (const slug of await getAllArticleSlugs()) {
    paths.add(slug);
  }

  return [...paths]
    .filter((slug) => !RESERVED_NON_ARTICLE_SLUGS.has(slug))
    .map((slug) => ({ params: { slug } }));
}

function humanizeSegment(segment: string): string {
  return segment
    .split("-")
    .map((w) => w.charAt(0).toLocaleUpperCase("tr-TR") + w.slice(1).toLocaleLowerCase("tr-TR"))
    .join(" ");
}

function titleFromSlug(slug: string): string {
  return slug
    .split("/")
    .filter(Boolean)
    .map(humanizeSegment)
    .join(" · ");
}

function buildBreadcrumb(
  slug: string,
  megaNavItems: Awaited<ReturnType<typeof getSiteNavigation>>["megaNav"],
): { label: string; href?: string }[] {
  const parts = slug.split("/").filter(Boolean);
  const items: { label: string; href?: string }[] = [{ label: "Ana sayfa", href: "/" }];
  const root = parts[0];
  const item = megaNavItems.find((m) => m.id === root);
  if (item && parts.length > 1) {
    const label = item.title
      .toLocaleLowerCase("tr-TR")
      .split(/\s+/)
      .filter(Boolean)
      .map((w) => w.charAt(0).toLocaleUpperCase("tr-TR") + w.slice(1))
      .join(" ");
    items.push({ label, href: item.href });
  }
  items.push({ label: humanizeSegment(parts[parts.length - 1] ?? "") });
  return items;
}

const { slug } = Astro.params;
const pathSlug = slug ?? "";

const siteNav = await getSiteNavigation();
const cmsArticle = await getCmsArticleBySlug(pathSlug);

const articleEntries = await getCollection("articles");
const mdEntry = articleEntries.find((e) => e.id === pathSlug);

let Content: Awaited<ReturnType<typeof render>>["Content"] | undefined;
if (mdEntry) {
  const rendered = await render(mdEntry);
  Content = rendered.Content;
}

const displayTitle = cmsArticle?.title ?? mdEntry?.data.title ?? titleFromSlug(pathSlug);
const canonicalPath = `/${pathSlug}`;
const leadFormPrefill = resolveLeadFormPrefillFromPath(canonicalPath);
const description =
  cmsArticle?.description ??
  mdEntry?.data.description ??
  `${displayTitle} — Campus Global yurtdışı eğitim rehberi. Detay içerik hazırlanıyor; danışmanlık için iletişime geçebilirsiniz.`;
const keywords =
  cmsArticle?.keywords ??
  mdEntry?.data.keywords ??
  "yurtdışı eğitim, Campus Global, danışmanlık, dil okulu, üniversite";
const publishedISO = cmsArticle?.publishedISO ?? mdEntry?.data.publishedISO ?? "2026-04-01T10:00:00+03:00";
const modifiedISO = cmsArticle?.modifiedISO ?? mdEntry?.data.modifiedISO ?? publishedISO;
const eyebrow = cmsArticle?.eyebrow ?? mdEntry?.data.eyebrow;
const section = cmsArticle?.section ?? mdEntry?.data.section;
const readingMinutes = cmsArticle?.readingMinutes ?? mdEntry?.data.readingMinutes;
const toc = cmsArticle?.toc?.length ? cmsArticle.toc : mdEntry?.data.toc?.length ? mdEntry.data.toc : undefined;
const faq = cmsArticle?.faq?.length ? cmsArticle.faq : mdEntry?.data.faq?.length ? mdEntry.data.faq : undefined;
const breadcrumb = buildBreadcrumb(pathSlug, siteNav.megaNav);
---

<ArticleLayout
  title={displayTitle}
  description={description}
  canonicalPath={canonicalPath}
  keywords={keywords}
  publishedISO={publishedISO}
  modifiedISO={modifiedISO}
  eyebrow={eyebrow}
  section={section}
  readingMinutes={readingMinutes}
  breadcrumb={breadcrumb}
  toc={toc}
  faq={faq}
  leadFormPrefill={leadFormPrefill}
>
  {
    mdEntry && Content ? (
      <Content />
    ) : (
      <>
        <p class="text-[17px] font-medium leading-relaxed text-zap-ink/90">
          <span class="font-semibold text-zap-night">{displayTitle}</span> sayfası için detaylı içerik hazırlanıyor. Benzer
          konularda{" "}
          <a class="font-semibold text-brand-teal underline-offset-2 hover:underline" href="/dil-okullari/hub">
            dil okulları
          </a>
          ,{" "}
          <a class="font-semibold text-brand-teal underline-offset-2 hover:underline" href="/universite/hub">
            üniversite
          </a>{" "}
          ve{" "}
          <a class="font-semibold text-brand-teal underline-offset-2 hover:underline" href="/yuksek-lisans/hub">
            yüksek lisans
          </a>{" "}
          hub sayfalarından devam edebilir veya doğrudan{" "}
          <a class="font-semibold text-brand-teal underline-offset-2 hover:underline" href="/iletisim">
            iletişim
          </a>{" "}
          kanallarımızdan yazılı özet talep edebilirsiniz.
        </p>

        <h2 id="ozet">Özet</h2>
        <p>
          Tam içerikli makaleler içerik panelinden veya <code class="rounded bg-zap-ink/[0.06] px-1.5 py-0.5 font-mono text-[13px]">src/content/articles/</code> altında
          yönetilir; yayın sonrası build ile siteye yansır.
        </p>

        <p class="mt-10 rounded-xl border-2 border-dashed border-zap-ink/15 bg-zap-ink/[0.03] px-4 py-3 text-center text-[12px] font-medium text-zap-ink/55">
          Yer tutucu — içerik panelinden veya Markdown dosyası ile güncelleyin.
        </p>
      </>
    )
  }
</ArticleLayout>
