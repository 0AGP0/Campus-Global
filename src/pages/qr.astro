        universiteHedefi: { devlet: "Devlet", ozel: "Özel", "yurt-disi": "Yurt Dışı" },
        pasaport: {
          "yesil-var": "Yeşil Var",
          "bordo-var": "Bordo Var",
          "henuz-yok": "Henüz Yok",
          "yesil-hakkim-var": "Yeşil Hakkı",
        },
      };

      function initExclusiveChips() {
        document.querySelectorAll("[data-exclusive]").forEach(function (group) {
          group.addEventListener("change", function (e) {
            var input = e.target;
            if (!input || input.type !== "checkbox" || !input.checked) return;
            group.querySelectorAll('input[type="checkbox"]').forEach(function (cb) {
              if (cb !== input) cb.checked = false;
            });
          });
        });
      }

      function initSuccessModal() {
        var modal = document.getElementById("qrSuccessModal");
        if (!modal) return null;

        function openSuccessModal() {
          modal.hidden = false;
          modal.setAttribute("aria-hidden", "false");
          document.body.style.overflow = "hidden";
        }

        function closeSuccessModal() {
          modal.hidden = true;
          modal.setAttribute("aria-hidden", "true");
          document.body.style.overflow = "";
        }

        modal.querySelectorAll("[data-close-modal]").forEach(function (el) {
          el.addEventListener("click", closeSuccessModal);
        });

        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && !modal.hidden) closeSuccessModal();
        });

        return { openSuccessModal: openSuccessModal, closeSuccessModal: closeSuccessModal };
      }

      function initForm(modalApi) {
        var form = document.getElementById("qrForm");
        var errorEl = document.getElementById("qrFormError");
        var submitBtn = document.getElementById("qrFormSubmit");
        if (!form) return;

        function checkedLabel(name) {
          var input = form.querySelector('input[name="' + name + '"]:checked');
          if (!input) return "";
          var map = LABEL_MAP[name];
          return (map && map[input.value]) || input.value;
        }

        function setMessage(el, show) {
          if (!el) return;
          el.hidden = !show;
        }

        function buildPayload() {
          return {
            rol: checkedLabel("rol"),
            adSoyad: (form.adSoyad.value || "").trim(),
            sehir: (form.sehir.value || "").trim(),
            telefon: (form.telefon.value || "").trim(),
            eposta: (form.eposta.value || "").trim(),
            yerlestirmePuani: (form.yerlestirmePuani.value || "").trim(),
            hedefBolum: (form.hedefBolum.value || "").trim(),
            alan: checkedLabel("alan"),
            liseTuru: checkedLabel("liseTuru"),
            ingilizce: checkedLabel("ingilizce"),
            universiteHedefi: checkedLabel("universiteHedefi"),
            pasaport: checkedLabel("pasaport"),
            eklemekIstedigin: (form.eklemekIstedigin.value || "").trim(),
            kaynak: "QR Sayfa",
            tarih: new Date().toISOString(),
          };
        }

        function toFormBody(payload) {
          var body = new URLSearchParams();
          Object.keys(payload).forEach(function (key) {
            body.append(key, payload[key] == null ? "" : String(payload[key]));
          });
          return body.toString();
        }

        function postViaIframe(payload) {
          return new Promise(function (resolve, reject) {
            var frameName = "qrMakeFrame_" + Date.now();
            var iframe = document.createElement("iframe");
            iframe.name = frameName;
            iframe.title = "make-webhook";
            iframe.style.cssText = "position:absolute;width:0;height:0;border:0;visibility:hidden";
            document.body.appendChild(iframe);

            var f = document.createElement("form");
            f.method = "POST";
            f.action = WEBHOOK_URL;
            f.target = frameName;
            f.acceptCharset = "UTF-8";
            f.style.display = "none";

            Object.keys(payload).forEach(function (key) {
              var input = document.createElement("input");
              input.type = "hidden";
              input.name = key;
              input.value = payload[key] == null ? "" : String(payload[key]);
              f.appendChild(input);
            });

            document.body.appendChild(f);

            var done = false;
            function cleanup(ok) {
              if (done) return;
              done = true;
              try {
                f.remove();
              } catch (e) {}
              try {
                iframe.remove();
              } catch (e) {}
              if (ok) resolve();
              else reject(new Error("iframe post failed"));
            }

            iframe.addEventListener("load", function () {
              cleanup(true);
            });
            try {
              f.submit();
            } catch (err) {
              cleanup(false);
              return;
            }
            setTimeout(function () {
              cleanup(true);
            }, 2000);
          });
        }

        function sendPayload(payload) {
          var body = toFormBody(payload);

          return fetch(WEBHOOK_URL, {
            method: "POST",
            headers: {
              "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
            },
            body: body,
            mode: "cors",
            credentials: "omit",
            cache: "no-store",
          })
            .then(function (res) {
              if (!res.ok) throw new Error("Webhook " + res.status);
              return res.text().catch(function () {
                return "";
              });
            })
            .catch(function () {
              return postViaIframe(payload);
            });
        }

        form.addEventListener("submit", function (e) {
          e.preventDefault();
          setMessage(errorEl, false);

          if (!form.checkValidity()) {
            form.reportValidity();
            return;
          }

          var payload = buildPayload();

          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = "Gönderiliyor...";
          }

          sendPayload(payload)
            .then(function () {
              form.reset();
              if (modalApi && modalApi.openSuccessModal) modalApi.openSuccessModal();
            })
            .catch(function () {
              setMessage(errorEl, true);
              setTimeout(function () {
                setMessage(errorEl, false);
              }, 5000);
            })
            .finally(function () {
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = "Gönder";
              }
            });
        });
      }

      function boot() {
        initExclusiveChips();
        initForm(initSuccessModal());
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", boot);
      } else {
        boot();
      }
    })();
  </script>
</Layout>
