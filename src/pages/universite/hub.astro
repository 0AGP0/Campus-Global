---
import Layout from "@/layouts/Layout.astro";
import { ProgramHubPage } from "@/components/program/ProgramHubPage";
import { getEntry } from "astro:content";
import { programHubModelFromEntry } from "@/lib/program-hub-from-content";

const entry = await getEntry("hubs", "universite");
if (!entry) throw new Error("Hub içeriği bulunamadı: universite");
const model = programHubModelFromEntry(entry);
---

<Layout title={model.layoutTitle} description={model.metaDescription}>
  <ProgramHubPage client:load model={model} />
</Layout>
